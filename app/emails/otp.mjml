<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" color="#131518" />
      <mj-text font-size="15px" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f1f0ec" width="520px">
    <mj-section background-color="#fbfbf9" padding="32px 36px" border-radius="12px">
      <mj-column>
        <mj-text font-size="13px" font-weight="600" letter-spacing="1px" text-transform="uppercase" color="#65686d">
          CV admin
        </mj-text>
        <mj-text font-size="22px" font-weight="700" padding-top="8px" padding-bottom="0">
          Your sign-in code
        </mj-text>
        <mj-text>Use this code to sign in to the admin panel. It expires in 5 minutes.</mj-text>
        <mj-text align="center" font-size="34px" font-weight="700" letter-spacing="8px" padding="16px 0">
          {{OTP}}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px 0 0 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#65686d">
          If you didn't request this, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
