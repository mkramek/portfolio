# Local development — see docker-compose.yml at the repo root for postgres/mailpit.
DATABASE_URL=postgresql://cv:cv@localhost:5432/cv

# Direct (non-pooled) connection string — required only when the provider needs a
# separate URL for `prisma migrate deploy` (e.g. Neon's pooled connection above).
# The app itself only ever reads DATABASE_URL.
# DIRECT_DATABASE_URL=

# Admin allow-list for Better Auth (single email).
ADMIN_EMAIL=

# Public origin of the app (used for magic-link/OTP URLs and cookie scope).
BETTER_AUTH_URL=http://localhost:3000

# Better Auth signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# SMTP (Mailpit locally: host 127.0.0.1, port 1025, no auth).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WebAuthn (passkeys) — rpID must be the host the app is served from;
# origin the full origin (no trailing slash).
AUTH_RPID=localhost
AUTH_ORIGIN=http://localhost:3000
