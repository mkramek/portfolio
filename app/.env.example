# Local development — see docker-compose.yml at the repo root for postgres/mailpit.
DATABASE_URL=postgresql://cv:cv@localhost:5432/cv

# Direct (non-pooled) connection string — required only when the provider needs a
# separate URL for `prisma migrate deploy` (e.g. Neon's pooled connection above).
# The app itself only ever reads DATABASE_URL.
# DIRECT_DATABASE_URL=

# Admin allow-list for Better Auth (single email).
ADMIN_EMAIL=

# Public origin of the app (used for magic-link/OTP URLs and cookie scope).
BETTER_AUTH_URL=http://localhost:3000

# Better Auth signing secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# SMTP (Mailpit locally: host 127.0.0.1, port 1025, no auth).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Mail transport: "smtp" (default) or "gmail-oauth".
# gmail-oauth sends via smtp.gmail.com:465 using XOAUTH2 — no app password, and
# SMTP_HOST/PORT/USER/PASS are ignored. An incomplete gmail-oauth config is a hard
# error at send time, never a silent fallback to SMTP.
MAIL_TRANSPORT=smtp

# Gmail XOAUTH2 — read only when MAIL_TRANSPORT=gmail-oauth.
# GMAIL_USER is both the account that authorized the app and the address every mail
# is sent from: SMTP_FROM's display name is kept, but its address is overridden to
# GMAIL_USER (Gmail would rewrite it anyway) with a warning logged.
# Mint GMAIL_REFRESH_TOKEN with: bun scripts/gmail-oauth.mjs
# Google Cloud setup: docs/impl/09-deployment.md § Gmail XOAUTH2
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# WebAuthn (passkeys) — rpID must be the host the app is served from;
# origin the full origin (no trailing slash).
AUTH_RPID=localhost
AUTH_ORIGIN=http://localhost:3000
